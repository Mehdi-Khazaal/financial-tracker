# Local development settings. Copy to `.env` and fill in what you need.
# Never put production credentials in this file or in `.env`.

# SQLite works for local development; the test suite uses its own.
DATABASE_URL=sqlite:///./fintrack_dev.db
# Any long random string locally (signs JWTs). In production: >= 32 bytes, secret.
SECRET_KEY=change-me-to-a-long-random-string-for-local-dev
ENVIRONMENT=development

# Encrypts stored Plaid tokens and 2FA secrets. Falls back to SECRET_KEY when unset.
PLAID_TOKEN_ENCRYPTION_KEY=

# Plaid (use sandbox locally)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=

# Email (Resend). Empty = emails are logged, not sent.
RESEND_API_KEY=
FROM_EMAIL=
FRONTEND_URL=http://localhost:3000

# Web push (VAPID). Empty = push delivery is skipped.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Assistant ("Fin"). Empty = the assistant route reports it is unavailable.
ANTHROPIC_API_KEY=

# Operations
CRON_SECRET=local-cron-secret
ALLOWED_ORIGINS=
ADMIN_EMAIL=
LOG_FORMAT=text
EXPOSE_API_DOCS=true
RUN_MIGRATIONS_ON_BOOT=true

# Launch controls
SIGNUPS_ENABLED=true
SIGNUP_INVITE_CODE=
REQUIRE_EMAIL_VERIFICATION=false
ASSISTANT_DAILY_TURN_CAP=150
ASSISTANT_DAILY_COST_CAP_USD=3.00

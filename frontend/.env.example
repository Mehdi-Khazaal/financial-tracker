# Frontend environment. Vite exposes only variables prefixed with VITE_ to the
# browser bundle, and they are baked in at build time.
#
# Mapping from the CRA-era names (set these on Vercel):
#   REACT_APP_VAPID_PUBLIC_KEY  ->  VITE_VAPID_PUBLIC_KEY

# Web-push application server key (public half of the VAPID pair). Leave empty
# to hide the push-notification switch in Settings.
VITE_VAPID_PUBLIC_KEY=

# Local development only: where `vite dev` / `vite preview` proxy `/api`.
# Defaults to the FastAPI dev server.
# VITE_DEV_API_TARGET=http://127.0.0.1:8000

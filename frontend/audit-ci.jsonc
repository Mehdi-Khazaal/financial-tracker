// audit-ci config — see https://github.com/IBM/audit-ci
// Runs against production deps only in CI.
{
  "$schema": "https://raw.githubusercontent.com/IBM/audit-ci/main/docs/schema.json",
  "high": true,
  "package-manager": "npm",
  "output-format": "text",
  "skip-dev": true,
  // GHSA-qwww-vcr4-c8h2 (react-router RSC-mode CSRF bypass) used to be
  // allowlisted here; react-router 7.18.2 patched it, so nothing is excused.
  "allowlist": []
}

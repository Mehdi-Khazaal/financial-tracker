{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/accounts",
      "destination": "https://financial-tracker-api-1osn.onrender.com/accounts/"
    },
    {
      "source": "/api/accounts/",
      "destination": "https://financial-tracker-api-1osn.onrender.com/accounts/"
    },
    {
      "source": "/api/categories",
      "destination": "https://financial-tracker-api-1osn.onrender.com/categories/"
    },
    {
      "source": "/api/categories/",
      "destination": "https://financial-tracker-api-1osn.onrender.com/categories/"
    },
    {
      "source": "/api/transactions",
      "destination": "https://financial-tracker-api-1osn.onrender.com/transactions/"
    },
    {
      "source": "/api/transactions/",
      "destination": "https://financial-tracker-api-1osn.onrender.com/transactions/"
    },
    {
      "source": "/api/transfers",
      "destination": "https://financial-tracker-api-1osn.onrender.com/transfers/"
    },
    {
      "source": "/api/transfers/",
      "destination": "https://financial-tracker-api-1osn.onrender.com/transfers/"
    },
    {
      "source": "/api/assets",
      "destination": "https://financial-tracker-api-1osn.onrender.com/assets/"
    },
    {
      "source": "/api/assets/",
      "destination": "https://financial-tracker-api-1osn.onrender.com/assets/"
    },
    {
      "source": "/api/savings-goals",
      "destination": "https://financial-tracker-api-1osn.onrender.com/savings-goals/"
    },
    {
      "source": "/api/savings-goals/",
      "destination": "https://financial-tracker-api-1osn.onrender.com/savings-goals/"
    },
    {
      "source": "/api/recurring",
      "destination": "https://financial-tracker-api-1osn.onrender.com/recurring/"
    },
    {
      "source": "/api/recurring/",
      "destination": "https://financial-tracker-api-1osn.onrender.com/recurring/"
    },
    {
      "source": "/api/loans",
      "destination": "https://financial-tracker-api-1osn.onrender.com/loans/"
    },
    {
      "source": "/api/loans/",
      "destination": "https://financial-tracker-api-1osn.onrender.com/loans/"
    },
    {
      "source": "/api/budgets",
      "destination": "https://financial-tracker-api-1osn.onrender.com/budgets/"
    },
    {
      "source": "/api/budgets/",
      "destination": "https://financial-tracker-api-1osn.onrender.com/budgets/"
    },
    {
      "source": "/api/rules",
      "destination": "https://financial-tracker-api-1osn.onrender.com/rules/"
    },
    {
      "source": "/api/rules/",
      "destination": "https://financial-tracker-api-1osn.onrender.com/rules/"
    },
    {
      "source": "/api/:path*",
      "destination": "https://financial-tracker-api-1osn.onrender.com/:path*"
    },
    {
      "source": "/((?!api/|assets/|sw\\.js|manifest\\.json|robots\\.txt|favicon|icon-|logo).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, max-age=0" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; script-src 'self' https://cdn.plaid.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://cdn.plaid.com; connect-src 'self' https://financial-tracker-api-1osn.onrender.com https://api.coingecko.com https://sandbox.plaid.com https://production.plaid.com; font-src 'self' https://fonts.gstatic.com; frame-src https://cdn.plaid.com; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
